with Files("**"):
    BUG_COMPONENT = ("Core", "Privacy: Anti-Tracking")

JAR_MANIFESTS += ["jar.mn"]

XPIDL_SOURCES += ["nsIApiAuditService.idl"]

XPIDL_MODULE = "toolkit_apiaudit"

XPCOM_MANIFESTS += ["components.conf"]

EXTRA_COMPONENTS += ["ApiAudit.manifest"]

MOZ_SRC_FILES += [
    "ApiAudit.sys.mjs",
    "ApiAuditChild.sys.mjs",
    "ApiAuditParent.sys.mjs",
    "ApiAuditRanking.sys.mjs",
]

EXPORTS.mozilla += [
    "ApiAudit.h",
    "ApiAuditScripts.h",
    "ApiAuditService.h",
]

UNIFIED_SOURCES += ["ApiAudit.cpp"]

LOCAL_INCLUDES += [
    "/dom/base",
    "/js/xpconnect/src",
]

BROWSER_CHROME_MANIFESTS += ["tests/browser/browser.toml"]

include("/ipc/chromium/chromium-config.mozbuild")

FINAL_LIBRARY = "xul"
